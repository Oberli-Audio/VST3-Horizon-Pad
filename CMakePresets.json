{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (what ships)",
      "description": "The release build (ship-bob versioning-and-provenance.md): universal on macOS, /MT and /arch:SSE4.2 on Windows, LTO, symbols kept beside the binary (dSYM, PDB) and the shipped binary stripped.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.13",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "HORIZON_RELEASE_SYMBOLS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "targets": [ "HorizonPad_VST3", "HorizonPad_Standalone" ]
    }
  ]
}
