# ---- Build output ----------------------------------------------------------
build/
build-*/
cmake-build-*/
out/
_deps/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.pdb
*.exp
*.ilk

# Built plugin bundles
*.vst3/
*.component/
*.au/

# ---- JUCE ------------------------------------------------------------------
# JUCE is fetched by CMake FetchContent into the build tree; it must never be
# committed here. A local checkout (if you keep one) is not tracked either.
JUCE/
JuceLibraryCode/
*.jucer.bak

# ---- CMake -----------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
compile_commands.json
install_manifest.txt

# ---- IDEs / editors --------------------------------------------------------
.vs/
.vscode/
.idea/
.cache/
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.suo
*.user
*.sln
*.vcxproj*
*.swp
*~

# ---- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Python ----------------------------------------------------------------
__pycache__/
*.pyc

# ---- Release assets CI writes into the checkout (a release is built from a clean tree:
# untracked files here made buildinfo.py record the tag's build as dirty) ----
/HorizonPad-*.zip
/build-info-*.json
/SHA256SUMS.txt
/RELEASE_NOTES.md
/enable-crashdumps.reg
/dist/

# ---- Machine-local: the toolchain is ~/.config/oberli/tools.toml, never in the repo ----
/ship.local.toml
/.env

# ---- Sample material, renders and listening-panel files live in OneDrive, not in git ----
*.wav
!tools/tests/golden/*.wav
!sound design/reference-renders/*
*.aif
*.aiff
*.m4a
